{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/make-me-admin/:secret",
      "destination": "/api/index.js"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
